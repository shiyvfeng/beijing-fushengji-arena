# 北京浮生记 Arena · Multi-Provider Direct Model 配置模板
# 复制为 .env 后填写；.env 已被 Git 忽略。不要提交或分享真实 API Key。
# A–E 是本地配置条目，不是观众身份。每组必须填写 provider/baseUrl/apiKey/model/reasoningEffort。
# provider 可写：gpt/openai、claude/anthropic、deepseek、qwen、kimi、openai-compatible。

# Agent A · GPT / OpenAI Responses
ARENA_AGENT_A_PROVIDER=gpt
ARENA_AGENT_A_BASE_URL=https://api.openai.com/v1
ARENA_AGENT_A_API_KEY=
ARENA_AGENT_A_MODEL=
ARENA_AGENT_A_REASONING_EFFORT=low
# 可选：声明模型 revision；响应中的 revision 优先，冲突只记审计 mismatch。
ARENA_AGENT_A_MODEL_REVISION=

# Agent B · Claude / Anthropic Messages
ARENA_AGENT_B_PROVIDER=claude
ARENA_AGENT_B_BASE_URL=https://api.anthropic.com/v1
ARENA_AGENT_B_API_KEY=
ARENA_AGENT_B_MODEL=
ARENA_AGENT_B_REASONING_EFFORT=low
ARENA_AGENT_B_MODEL_REVISION=

# Agent C · DeepSeek / OpenAI-compatible Chat Completions
ARENA_AGENT_C_PROVIDER=deepseek
ARENA_AGENT_C_BASE_URL=https://api.deepseek.com
ARENA_AGENT_C_API_KEY=
ARENA_AGENT_C_MODEL=
ARENA_AGENT_C_REASONING_EFFORT=low
ARENA_AGENT_C_MODEL_REVISION=
# DeepSeek 专用：default（不传字段）/disabled/enabled。配置 effort 时必须开启思考。
ARENA_AGENT_C_THINKING=enabled

# Agent D · Qwen / OpenAI-compatible Chat Completions
ARENA_AGENT_D_PROVIDER=qwen
ARENA_AGENT_D_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARENA_AGENT_D_API_KEY=
ARENA_AGENT_D_MODEL=
ARENA_AGENT_D_REASONING_EFFORT=low
ARENA_AGENT_D_MODEL_REVISION=

# Agent E · Kimi / OpenAI-compatible Chat Completions
ARENA_AGENT_E_PROVIDER=kimi
ARENA_AGENT_E_BASE_URL=https://api.moonshot.cn/v1
ARENA_AGENT_E_API_KEY=
ARENA_AGENT_E_MODEL=
ARENA_AGENT_E_REASONING_EFFORT=low
ARENA_AGENT_E_MODEL_REVISION=

# 若把 DeepSeek 放到其他槽位，使用对应槽位变量，例如：
# ARENA_AGENT_D_THINKING=enabled

# 每次 Probe + Stability + Match 应显式使用同一个新目录；已有比赛产物时 Runner 会拒绝覆盖。
ARENA_OUTPUT_DIR=

# 可选比赛参数。ARENA_MATCH_ID 留空时按 seed 自动生成。
ARENA_MATCH_ID=
ARENA_SEED=20260820
ARENA_MAX_ACTIONS_PER_AGENT=160
ARENA_DECISION_TIMEOUT_MS=120000
# 留空时解析为 maxActionsPerAgent × decisionTimeoutMs。
ARENA_TOTAL_WALL_CLOCK_MS=
ARENA_MAX_OUTPUT_TOKENS=512
# cyclic-v1 轮换索引，只支持 0..4。
ARENA_SLOT_ROTATION_INDEX=0

# 默认关闭。开启时仅写入已脱敏的 dist/arena-diagnostics/<matchId>/<probe|stability|match>/。
ARENA_SAVE_RAW_EXCHANGES=false

# 付费调用确认故意不允许写在这里。
# Probe、Stability 与正式比赛都必须通过对应的显式命令授权；正式比赛仍需 --confirm-live-run。
