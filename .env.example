# 北京浮生记 Arena · Multi-Provider Direct Model 配置模板
# 复制为 .env 后填写；.env 已被 Git 忽略。不要提交或分享真实 API Key。
# 每个 Agent 都必须独立填写 provider/baseUrl/apiKey/model。
# provider 可写：gpt/openai、claude/anthropic、deepseek、qwen、kimi、openai-compatible。

# Agent A · GPT / OpenAI Responses
ARENA_AGENT_A_PROVIDER=gpt
ARENA_AGENT_A_BASE_URL=https://api.openai.com/v1
ARENA_AGENT_A_API_KEY=
ARENA_AGENT_A_MODEL=

# Agent B · Claude / Anthropic Messages
ARENA_AGENT_B_PROVIDER=claude
ARENA_AGENT_B_BASE_URL=https://api.anthropic.com/v1
ARENA_AGENT_B_API_KEY=
ARENA_AGENT_B_MODEL=

# Agent C · DeepSeek / OpenAI-compatible Chat Completions
ARENA_AGENT_C_PROVIDER=deepseek
ARENA_AGENT_C_BASE_URL=https://api.deepseek.com
ARENA_AGENT_C_API_KEY=
ARENA_AGENT_C_MODEL=
# DeepSeek 专用：default（不传字段）/disabled/enabled。短 JSON 动作默认建议 disabled。
ARENA_AGENT_C_THINKING=disabled

# Agent D · Qwen / OpenAI-compatible Chat Completions
ARENA_AGENT_D_PROVIDER=qwen
ARENA_AGENT_D_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARENA_AGENT_D_API_KEY=
ARENA_AGENT_D_MODEL=

# Kimi（替换任意槽位）示例：
# ARENA_AGENT_D_PROVIDER=kimi
# ARENA_AGENT_D_BASE_URL=https://api.moonshot.cn/v1
# ARENA_AGENT_D_API_KEY=
# ARENA_AGENT_D_MODEL=

# 若把 DeepSeek 放到其他槽位，使用对应槽位变量，例如：
# ARENA_AGENT_D_THINKING=disabled

# 每次运行应使用一个新的输出目录；已有同名产物时 Runner 会拒绝覆盖。
ARENA_OUTPUT_DIR=dist/arena-direct/run-001

# 可选比赛参数。ARENA_MATCH_ID 留空时按 seed 自动生成。
ARENA_MATCH_ID=
ARENA_SEED=20260820
ARENA_MAX_ACTIONS_PER_AGENT=160
ARENA_DECISION_TIMEOUT_MS=60000
ARENA_MAX_OUTPUT_TOKENS=512

# 付费调用确认故意不允许写在这里。
# 真实运行时仍需在命令中显式添加 --confirm-live-run。
