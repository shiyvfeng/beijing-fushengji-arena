# Web 服务配置；模型、API Key 在浏览器的“模型管理”中填写。
ARENA_HOST=127.0.0.1
ARENA_PORT=3000
# 默认保存到仓库 var/；生产环境应设为持久数据卷。
ARENA_DATA_DIR=
# 远程监听时必须配置至少 12 位管理员密码；本机回环模式可留空。
ARENA_ADMIN_PASSWORD=
# HTTPS 反向代理部署时设置 true。
ARENA_COOKIE_SECURE=false
# 额外信任的模型网关主机名，逗号分隔；官方供应商默认已包含。
# 例如 gateway.example.com,localhost
ARENA_ALLOWED_MODEL_HOSTS=
# CLI 专用模型模板在 docs/cli.env.example；请用 --env-file 显式指定。
