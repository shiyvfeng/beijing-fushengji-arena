{
  "name": "beijing-fushengji-mcp",
  "version": "1.0.0",
  "description": "北京浮生记 - AI Agent MCP Game Server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "beijing-fushengji": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "arena:sample": "npm run build && node dist/arena-cli.js --replay-only --output dist/arena-demo/replay.json",
    "arena:direct": "node scripts/run-arena-direct.mjs --",
    "arena:replay": "node scripts/build-arena-replay.mjs",
    "model:list": "node tools/model-list-query/query-models.mjs",
    "build:arena": "node scripts/build-arena-demo.mjs",
    "test:arena-core": "npm run build && node --test tests/core/*.test.mjs",
    "test:arena-web": "npm --prefix web test",
    "test:arena": "npm run test:arena-core && npm run test:arena-web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.13.10"
  }
}
